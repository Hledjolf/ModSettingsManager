// A setting with a fixed list of options, shown as a dropdown.
$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 40, Bottom: 4);

  Label #Changed {
    Text: "*";
    Visible: false;
    Anchor: (Width: 14);
    Style: (FontSize: 18, RenderBold: true, TextColor: #e8a93b, VerticalAlignment: Center);
  }

  Label #Label {
    Text: "";
    Anchor: (Width: 300, Right: 12);
    Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  $C.@DropdownBox #Input {
    @Anchor = (Top: 4, Right: 12);

    // Vanilla uppercases every dropdown text; keep the case so "mm" (minutes) and "MM" (months) stay apart.
    Style: (
      ...$C.@DefaultDropdownBoxStyle,
      LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false),
      EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false),
      NoItemsLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #b7cedd(0.5), RenderUppercase: false),
      SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderBold: true, RenderUppercase: false)
    );
  }

  Label #Hint {
    Text: "";
    FlexWeight: 1;
    Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center, Wrap: true);
  }
}
