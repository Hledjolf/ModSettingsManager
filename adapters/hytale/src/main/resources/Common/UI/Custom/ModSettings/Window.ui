// Mod Settings Manager: the settings window. Mods on the left, the selected mod's settings on the right.
// Rows are appended into #Rows from the *Row.ui documents; the buttons are appended into #Footer.
$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1180, Height: 760);

  #Title {
    Group {
      $C.@Title {
        @Text = "Mod Settings";
      }
    }
  }

  #Content {
    LayoutMode: Left;

    Group #Left {
      Anchor: (Width: 300);
      LayoutMode: Top;
      Padding: (Right: 12);

      $C.@TextField #Search {
        @Anchor = (Bottom: 6);
        PlaceholderText: "Search mods and settings";
      }

      Label #ModCount {
        Text: "";
        Anchor: (Height: 20, Bottom: 4);
        Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center);
      }

      Group #ModList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    Group #Right {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #ModName {
        Text: "";
        Anchor: (Height: 30);
        Style: (FontSize: 22, RenderBold: true, VerticalAlignment: Center);
      }

      Label #ModMeta {
        Text: "";
        Anchor: (Height: 20);
        Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center);
      }

      Label #SidecarNote {
        Text: "";
        Anchor: (Height: 24, Bottom: 6);
        Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center);
      }

      Group #RestartBanner {
        Visible: false;
        Anchor: (Height: 46, Bottom: 6);
        Padding: (Horizontal: 10, Vertical: 4);
        Background: #8a6420(0.55);

        Label #RestartText {
          Text: "";
          Style: (FontSize: 15, TextColor: #ffe2a8, VerticalAlignment: Center, Wrap: true);
        }
      }

      Group #RevertBanner {
        Visible: false;
        Anchor: (Height: 46, Bottom: 6);
        Padding: (Horizontal: 10, Vertical: 4);
        Background: #7a2424(0.55);

        Label #RevertText {
          Text: "";
          Style: (FontSize: 14, TextColor: #ffcaca, VerticalAlignment: Center, Wrap: true);
        }
      }

      Group #Rows {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 8);
      }

      Label #Status {
        Text: "";
        Anchor: (Height: 26, Top: 4);
        Style: (FontSize: 14, TextColor: #e8a93b, VerticalAlignment: Center, Wrap: true);
      }

      Group #Footer {
        Anchor: (Height: 48, Top: 4);
        LayoutMode: Top;
      }
    }
  }
}

$C.@BackButton {}
