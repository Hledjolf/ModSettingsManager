// A true/false setting.
$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 40, Bottom: 4);

  Label #Changed {
    Text: "*";
    Visible: false;
    Anchor: (Width: 14);
    Style: (FontSize: 18, RenderBold: true, TextColor: #e8a93b, VerticalAlignment: Center);
  }

  Label #Label {
    Text: "";
    Anchor: (Width: 300, Right: 12);
    Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  Group {
    Anchor: (Width: 160, Right: 12);

    $C.@CheckBox #Input {
      Anchor: (Width: 26, Height: 26, Left: 0, Top: 7);
    }
  }

  Label #Hint {
    Text: "";
    FlexWeight: 1;
    Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center, Wrap: true);
  }
}
