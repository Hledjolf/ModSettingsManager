// A list, an object or another value shown read-only: edit the file to change it.
$C = "../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 40, Bottom: 4);

  Label #Changed {
    Text: "*";
    Visible: false;
    Anchor: (Width: 14);
    Style: (FontSize: 18, RenderBold: true, TextColor: #e8a93b, VerticalAlignment: Center);
  }

  Label #Label {
    Text: "";
    Anchor: (Width: 300, Right: 12);
    Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  }

  Label #Value {
    Text: "";
    Anchor: (Width: 340, Right: 12);
    Style: (FontSize: 14, TextColor: #c9d1d9, VerticalAlignment: Center, Wrap: true);
  }

  Label #Hint {
    Text: "";
    FlexWeight: 1;
    Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center, Wrap: true);
  }
}
